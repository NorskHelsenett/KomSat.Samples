root = true

[*.{props,targets,csproj,xml,config}]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true


# ReSharper properties
csharp_wrap_object_and_collection_initializer_style = chop_always
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
resharper_braces_for_while = required
resharper_csharp_wrap_after_declaration_lpar = true
resharper_csharp_wrap_arguments_style = chop_if_long
resharper_braces_for_foreach = required
resharper_braces_for_ifelse = required
resharper_csharp_allow_alias = false
resharper_csharp_wrap_after_invocation_lpar = true
resharper_csharp_wrap_extends_list_style = chop_always
resharper_csharp_wrap_parameters_style = chop_if_long
resharper_csharp_wrap_ternary_expr_style = chop_always
resharper_keep_existing_declaration_parens_arrangement = false
resharper_keep_existing_linebreaks = false
resharper_keep_existing_primary_constructor_declaration_parens_arrangement = true
resharper_max_formal_parameters_on_line = 2
resharper_max_invocation_arguments_on_line = 3
resharper_max_primary_constructor_parameters_on_line = 5
resharper_place_accessorholder_attribute_on_same_line = false
resharper_wrap_after_property_in_chained_method_calls = true
resharper_wrap_before_extends_colon = false
resharper_wrap_before_first_method_call = true
resharper_wrap_before_primary_constructor_declaration_lpar = false
resharper_wrap_chained_method_calls = chop_if_long
resharper_convert_to_primary_constructor_highlighting = none

csharp_style_prefer_primary_constructors = false
